# ── Supabase configuration for MNR Cycle Mart ──────────────────────────
# Copy this file to `.env` and fill in the values from your Supabase
# project dashboard (Project Settings > API).
#
# Use ONLY the PUBLISHABLE key in the browser. Never put the secret or
# service-role key in this file or in any frontend code.
VITE_SUPABASE_URL=your-project-url (e.g. https://<ref>.supabase.co)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key (sb_publishable_...)